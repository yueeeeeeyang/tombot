{
  "PATH": "/usr/local/go/bin:/usr/local/node/bin:/usr/local/bin:/usr/bin:/bin:/workspace/tools/bin:/workspace/tools/node/bin:/workspace/tools/pnpm:/workspace/tools/pnpm/bin:/workspace/tools/bun/bin:/workspace/tools/go/bin:/workspace/tools/cargo/bin",
  "HOME": "/workspace",
  "USER": "bot{{uid}}",
  "LOGNAME": "bot{{uid}}",
  "SHELL": "/bin/bash",
  "LANG": "zh_CN.UTF-8",
  "LC_ALL": "zh_CN.UTF-8",
  "DISPLAY": ":{{display}}",
  "XAUTHORITY": "{{runtime}}/Xauthority",
  "ICEAUTHORITY": "{{runtime}}/ICEauthority",
  "XDG_RUNTIME_DIR": "{{runtime}}",
  "XDG_CONFIG_HOME": "{{runtime}}/config",
  "XDG_CACHE_HOME": "{{runtime}}/cache",
  "XDG_STATE_HOME": "{{runtime}}/state",
  "XDG_DATA_HOME": "{{runtime}}/data",
  "TMPDIR": "/workspace/.tmp",
  "TMP": "/workspace/.tmp",
  "TEMP": "/workspace/.tmp",
  "XDG_CONFIG_DIRS": "/etc/xdg",
  "XDG_DATA_DIRS": "/usr/local/share:/usr/share",
  "XDG_SESSION_TYPE": "x11",
  "XDG_CURRENT_DESKTOP": "XFCE",
  "DESKTOP_SESSION": "xfce",
  "GDK_BACKEND": "x11",
  "QT_QPA_PLATFORM": "xcb",
  "DBUS_SESSION_BUS_ADDRESS": "unix:path={{runtime}}/bus",
  "LD_PRELOAD": "/usr/lib/tombot-nss-wrapper.so",
  "NSS_WRAPPER_PASSWD": "{{runtime}}/passwd",
  "NSS_WRAPPER_GROUP": "{{runtime}}/group",
  "GOTOOLCHAIN": "local",
  "GOPATH": "/workspace/tools/go",
  "CARGO_HOME": "/workspace/tools/cargo",
  "UV_TOOL_BIN_DIR": "/workspace/tools/bin",
  "UV_TOOL_DIR": "/workspace/tools/uv",
  "UV_PYTHON_DOWNLOADS": "never",
  "NPM_CONFIG_PREFIX": "/workspace/tools/node",
  "PNPM_HOME": "/workspace/tools/pnpm",
  "BUN_INSTALL": "/workspace/tools/bun",
  "PYTHONDONTWRITEBYTECODE": "1",
  "http_proxy": "http://127.0.0.1:3128",
  "https_proxy": "http://127.0.0.1:3128",
  "HTTP_PROXY": "http://127.0.0.1:3128",
  "HTTPS_PROXY": "http://127.0.0.1:3128",
  "no_proxy": "127.0.0.1,localhost,::1",
  "NO_PROXY": "127.0.0.1,localhost,::1"
}
