[Unit]
Description=TomBot 受信宿主电脑节点
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
UMask=0077
Environment=TOM_NODE_CONFIG=/etc/tombot/node/node.json
Environment=TOM_DOCKER_INSTALL_MANIFEST=/etc/tombot/node/docker-install.json
Environment=TOM_IMAGE_PREPARATION_MANIFEST=/etc/tombot/node/computer-image.json
ExecStart=/usr/lib/tombot/tomnode start
Restart=on-failure
RestartSec=5s
TimeoutStartSec=140min
TimeoutStopSec=11min
KillMode=control-group
NoNewPrivileges=true
RuntimeDirectory=tombot
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
StateDirectory=tombot-node/bootstrap tombot-node/images tombot-node/runtime tombot-node/storage tombot-node/workspaces
StateDirectoryMode=0700

# 磁盘挂载须能被宿主 Docker 看到，不启用 PrivateTmp、ProtectSystem 等私有挂载命名空间。
# root 权限只属于本节点；API 和 Worker 使用固定非 root 控制身份。
# 控制端口由 node.json 的 listen 指定，访问控制依赖 TLS 证书指纹与防火墙白名单；
# 跨主机部署时必须只放行 API 的出口地址，不能对公网全开。
# 启动预算覆盖配置检查、最多各一小时的宿主安装及镜像准备，以及节点构造与失败清理。
# 安装阶段使用 root 的宿主包管理权限，不授予子进程额外提权能力。

[Install]
WantedBy=multi-user.target
