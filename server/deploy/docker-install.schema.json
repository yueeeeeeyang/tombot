{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨发行版 Docker 安装预算",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "timeout_seconds",
    "minimum_free_bytes"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "minimum_free_bytes": {
      "type": "integer",
      "minimum": 1073741824,
      "maximum": 107374182400
    }
  }
}
