[Unit]
Description=Tom 个人工作台服务
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tom
Group=tom
UMask=0077
StateDirectory=tom
StateDirectoryMode=0700
RuntimeDirectory=tom
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/tom
Environment=HOME=/var/lib/tom
Environment=TOM_ADDR=127.0.0.1:8787
Environment=TOM_DATA_DIR=/var/lib/tom/data
Environment=TOM_WORKSPACE_DIR=/var/lib/tom/workspace
EnvironmentFile=-/etc/tom/tom.env
ExecStart=/usr/local/bin/tomd
# 首次初始化码仅写入服务私有的运行目录，常规诊断从标准错误进入日志。
StandardOutput=truncate:/run/tom/console
StandardError=journal
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target
